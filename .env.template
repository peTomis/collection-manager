MONGODB_URI=

# NextAuth: generate the secret with `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:5555
NEXTAUTH_SECRET=

# Google OAuth client (redirect URI: <NEXTAUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only for `yarn db:setup --apply`: a user with the dbAdmin role (the app's own user should only have readWrite)
MONGODB_ADMIN_URI=

# Optional: error reporting to Sentry (off without the DSN). The other three upload source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
